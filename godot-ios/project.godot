; Engine configuration file.
; "Дворовые разборки: Казань 1996" - mobile beat 'em up prototype.
config_version=4

[application]
config/name="Дворовые разборки: Казань 1996"
run/main_scene="res://scenes/Main.tscn"
config/description="Пиксельная дворовая аркада для iPhone."

[display]
window/size/width=960
window/size/height=540
window/size/test_width=960
window/size/test_height=540
window/handheld/orientation=1
window/stretch/mode="2d"
window/stretch/aspect="expand"

[rendering]
quality/driver/driver_name="GLES2"
quality/2d/use_pixel_snap=true
environment/default_clear_color=Color(0.07, 0.09, 0.12, 1)
